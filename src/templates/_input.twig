{% set mapData = mapdata %}
{% if settings is not empty %}
  {% set mapData = mapData|merge(settings) %}
{% endif %}

{% if value is not empty %}
  {% set mapData = mapData|merge(value) %}
{% endif %}

{% if global_settings.mapToken is not empty %}
	<div x-data="appgeo" x-init="initMap({{mapData|json_encode}}, true, {{settings|json_encode()}})" class="supgeo {{settings.hideMap ? ' --hideMap':''}}" >
		<div class="supgeo__wrapper" x-ref="geowrapper">
			<div class="supgeo__wrapper_map">
				{% if settings.hideSearch == false %}
					<div class="supgeo__search"  x-show="!notokenAdded" >
						<div class="supgeo__search_icon">
							<svg width="25" height="24" fill="none" viewbox="0 0 25 24">
								<path fill="#5e5e5e" fill-rule="evenodd" d="M15.56 13.27 21.29 19l-1.49 1.49-5.73-5.73A6.4 6.4 0 0110.3 16a6.5 6.5 0 116.5-6.5c0 1.41-.47 2.7-1.24 3.77M10.3 5a4.5 4.5 0 10-.01 8.99A4.5 4.5 0 0010.3 5" clip-rule="evenodd"></path>
							</svg>
						</div>
						<div x-ref="apgeo-search" class="supgeo__search_input"></div>
						<button  x-cloak class="supgeo__search_clear" type="button" x-show="full_address != null" @click="clearAddress()" title="clear address" aria-label="Clear search">
							<svg width="21" height="20" fill="none" viewbox="0 0 21 20">
								<path fill="#1f1f1f" fill-rule="evenodd" d="M10.8 0a10 10 0 100 20 10 10 0 100-20m2.59 6L10.8 8.59 8.21 6 6.8 7.41 9.39 10 6.8 12.59 8.21 14l2.59-2.59L13.39 14l1.41-1.41L12.21 10l2.59-2.59zM2.8 10a8.01 8.01 0 0016 0 8.01 8.01 0 00-16 0" clip-rule="evenodd"></path>
							</svg>
						</button>
					</div>
				{% endif %}
				{% set hideAdress = settings.hideAddress ?? false  %}
				{% if hideAdress  == false %}
					<div class="supgeo_field"  x-show="!notokenAdded" >
						<div class="input">
							<input x-model="full_address" name="{{ name }}[full_address]" class="text fullwidth" type="text" placeholder="Full Address">
						</div>
						<div class="input">
							<input x-model="address1" name="{{ name }}[address1]" class="text fullwidth" type="text" placeholder="Address Line 1">
						</div>
						<div class="input">
							<input x-model="suburb" name="{{ name }}[suburb]" class="text fullwidth" type="text" placeholder="Suburb">
						</div>
						<div class="input">
							<input x-model="postcode" name="{{ name }}[postcode]" type="text" class="text fullwidth" placeholder="Postcode">
						</div>
						<div class="input">
							<input x-model="country" name="{{ name }}[country]" class="text fullwidth" type="text" placeholder="Country">
						</div>
						<div class="input">
							<input hidden x-model="countryCode" name="{{ name }}[countryCode]" class="text fullwidth" type="text" placeholder="countryCode">
						</div>
						<div class="supgeo_input__group">
							<div class="input">
								<input x-model="lat" name="{{ name }}[lat]" type="text" class="text fullwidth" placeholder="Latitude">
							</div>
							<div class="input">
								<input x-model="lng" name="{{ name }}[lng]" type="text" class="text fullwidth" placeholder="Longtitude">
							</div>
						</div>
					</div>
				{% endif %}
			</div>
			<div x-ref="appgeo-map" class="supgeo__map --small"></div>
			<textarea hidden name="{{name}}[geoJson]" x-model="geojsonText"></textarea>
			<div class="supgeo_tools">
				<div class="btngroup">
					<button @click="toggleEditor()" type="button" class=" btn">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" style="height: 15px; width: 15px; margin-right: 5px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
						<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
						</svg>
						GeoJSON Editor
					</button>
					<button class="btn" type="button" title="Download" @click.prevent="download({{ elementId }})">
						<svg xmlns="http://www.w3.org/2000/svg" style="height: 15px; width: 15px; margin-right: 5px" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/>
						</svg>
						Download
					</button>
					<button type="button" class="btn" @click="triggerUpload()" :disabled="uploadStatus === 'reading' || uploadStatus === 'parsing'" title="Upload GeoJSON file">
						<svg xmlns="http://www.w3.org/2000/svg" style="height: 15px; width: 15px; margin-right: 5px" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="17 8 12 3 7 8"/>
							<line x1="12" y1="3" x2="12" y2="15"/>
						</svg>
						Upload
					</button>
				</div>
				<div class="supgeo-upload-wrap">

					<input type="file" accept=".geojson,.json,application/json,application/geo+json" x-ref="geojson-upload-input" class="supgeo-upload-hidden" @change="uploadGeoJSON($event.target.files[0]); $event.target.value = ''"/>


					<div class="supgeo-upload-progress" x-show="uploadStatus !== null" x-transition:enter="supgeo-fade-enter" x-transition:enter-start="supgeo-fade-enter-start" x-transition:leave="supgeo-fade-leave" x-transition:leave-end="supgeo-fade-leave-end">
						<div class="supgeo-progress-track" x-show="uploadStatus !== 'error'" role="progressbar" :aria-valuenow="uploadProgress" aria-valuemin="0" aria-valuemax="100">
							<div class="supgeo-progress-bar" :class="{
													'--reading':  uploadStatus === 'reading',
													'--parsing':  uploadStatus === 'parsing',
													'--done':     uploadStatus === 'done'
												}" :style="`width: ${uploadProgress}%`"></div>
						</div>

						<span class="supgeo-upload-label">
							<template x-if="uploadStatus === 'reading'">
								<span>Reading file…
									<strong x-text="uploadProgress + '%'"></strong>
								</span>
							</template>
							<template x-if="uploadStatus === 'parsing'">
								<span>Parsing GeoJSON…</span>
							</template>
							<template x-if="uploadStatus === 'done'">
								<span class="--success">✓ GeoJSON loaded successfully</span>
							</template>
							<template x-if="uploadStatus === 'error'">
								<span class="--error">✗
									<span x-text="uploadError"></span>
								</span>
							</template>
						</span>
					</div>

				</div>
			</div>
			<div x-ref="geojson-editor" class="geojson-editor" :class="{ active: showEditor }"></div>
		</div>
	</div>
{% else %}
	<div>
		<p>Please add a valid google token. Go to plugin settings <a href="/admin/settings/plugins/geo">Settings > Geo Maps</a>.</p>
	</div>
{% endif %}

