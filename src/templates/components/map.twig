<div x-data="appgeo" x-intersect.once="initMap({{mapdata|json_encode}})" class="supgeo">
	<div class="supgeo__wrapper">
		<input 
		    type="hidden"
			name="{{'lat'}}" 
			x-model="lat"
		>

		<input 
		    type="hidden"
			name="{{ 'lng'}}" 
			x-model="lng"
		>

		<div class="field">
			<div x-ref="apgeo-search" class="input"></div>
		</div>

		<div x-ref="appgeo-map" class="supgeo__map --small"></div>
	</div>
</div>
